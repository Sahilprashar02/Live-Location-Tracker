# Shared
KAFKA_BROKERS=localhost:9092
LOCATION_TOPIC=location-updates

# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-secret
LOCATION_INTERVAL_MS=5000
STALE_USER_MS=45000

# OIDC / OAuth 2.0
# Set DEMO_AUTH=true for local development without an external provider.
DEMO_AUTH=true
OIDC_ISSUER_URL=https://your-provider/.well-known/openid-configuration
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
OIDC_REDIRECT_URI=http://localhost:4000/auth/callback
OIDC_SCOPES=openid profile email

# Client
VITE_API_URL=http://localhost:4000
VITE_LOCATION_INTERVAL_MS=5000
