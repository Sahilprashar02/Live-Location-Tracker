# ═══════════════════════════════════════════════════════════════════════════════
# Live Location Tracker — Production Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
#
# Used by docker-compose.prod.yml (backend only) on Oracle Cloud.
# Place at: /opt/apps/live-location-tracker/.env  (on the server)
#
# Copy and fill in values:
#   cp .env.production.example .env
#
# NEVER commit this file to git. Variable names match what the backend code
# actually reads (see backend/src/server.js → validateEnv()).
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ─── Public URL of the frontend (Vercel) ─────────────────────────────────────
# Single origin used for CORS and the post-OAuth redirect. Must match exactly.
CLIENT_URL=https://live-location-tracker-jade.vercel.app

# ─── MongoDB (global Docker container — NOT local) ───────────────────────────
# Create the user once on the server:
#   /opt/apps/infra/scripts/add-app-mongo-user.sh location_tracker location_tracker_user '<strong-password>'
MONGODB_URI=mongodb://location_tracker_user:CHANGE_ME@global-mongodb:27017/location_tracker?authSource=location_tracker

# ─── Kafka (global shared Docker broker) ─────────────────────────────────────
# In-network address of the shared `global-kafka` container.
KAFKA_BROKER=global-kafka:9092
# The shared production broker is plaintext on platform-network, so no TLS/SASL
# variables are set here. If this project ever moves to a hosted broker, set
# either the mTLS triple or SASL/PLAIN (KAFKA_BROKER must match that broker):
# KAFKA_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# KAFKA_ACCESS_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# KAFKA_ACCESS_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# KAFKA_USERNAME=your_kafka_username
# KAFKA_PASSWORD=your_kafka_password

# ─── Static frontend (optional; production is backend-only) ──────────────────
# The image does not contain frontend/, so this is already off. Set only if
# you deliberately build an all-in-one deployment.
# SERVE_FRONTEND=false

# ─── Session / JWT signing secret ────────────────────────────────────────────
# Generate: openssl rand -base64 32
SESSION_SECRET=CHANGE_ME

# ─── Google OAuth 2.0 ────────────────────────────────────────────────────────
# Register this exact redirect URI in Google Cloud Console. It stays on the
# Vercel domain; frontend/vercel.json proxies /auth/* to the backend.
#   https://live-location-tracker-jade.vercel.app/auth/google/callback
GOOGLE_CALLBACK_URL=https://live-location-tracker-jade.vercel.app/auth/google/callback
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
