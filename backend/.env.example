# Google OAuth 2.0 Credentials
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Optional. If unset, Passport uses /auth/google/callback on the backend origin.
# GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Session
SESSION_SECRET=your_super_secret_session_key_change_this

# MongoDB
MONGODB_URI=mongodb://localhost:27018/location-tracker

# Kafka
KAFKA_BROKER=localhost:9092
# For hosted Kafka with client certificates, such as Aiven:
# KAFKA_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# KAFKA_ACCESS_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# KAFKA_ACCESS_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# For hosted Kafka with SASL/PLAIN instead:
# KAFKA_USERNAME=your_kafka_username
# KAFKA_PASSWORD=your_kafka_password

# Server
PORT=3000

# Optional: only set this if serving the frontend from a different origin.
# Backend-served frontend: http://localhost:3000
# Vite dev server:         http://localhost:5173
# CLIENT_URL=http://localhost:5173

# Optional: set to "false" to disable static frontend serving even when
# frontend/index.html exists. The production image has no frontend directory.
# SERVE_FRONTEND=false
